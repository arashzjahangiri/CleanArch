# Copy this file to .env, then replace every value below.
# .env is git-ignored, so your real passwords stay on your machine.

# SQL Server "sa" password.
# Must be at least 8 characters and mix upper case, lower case, digits and symbols,
# otherwise the SQL Server container refuses to start.
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!Pass

# Redis password. Any non-empty value works.
REDIS_PASSWORD=ChangeMe_Str0ng!Pass

# Host port for the API. Change it if 8080 is already taken on your machine.
API_PORT=8080
